<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bankos_launch_background">#041126</color>

    <!-- Match AppTheme.scaffoldBackgroundColor through Flutter's first frame. -->
    <style name="BankOSWindowTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bankos_launch_background</item>
        <item name="android:statusBarColor">@color/bankos_launch_background</item>
        <item name="android:navigationBarColor">@color/bankos_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="LaunchTheme" parent="BankOSWindowTheme" />
    <style name="NormalTheme" parent="BankOSWindowTheme" />
</resources>
